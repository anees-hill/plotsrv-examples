[Unit]
Description=plotsrv website and demo HTTPS proxy
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User=plotsrv-proxy
Group=plotsrv-proxy
EnvironmentFile=/etc/plotsrv-demo/cloudflare.env
Environment=XDG_DATA_HOME=/var/lib/plotsrv-demo-proxy
Environment=XDG_CONFIG_HOME=/var/lib/plotsrv-demo-proxy
ExecStart=/usr/local/bin/caddy-plotsrv run --config /etc/plotsrv-demo/Caddyfile --adapter caddyfile
ExecReload=/usr/local/bin/caddy-plotsrv reload --config /etc/plotsrv-demo/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/plotsrv-demo-proxy

[Install]
WantedBy=multi-user.target
