[Unit]
Description=Publish prepared plotsrv demo content (%i)
Requires=plotsrv-demo@%i.service
After=plotsrv-demo@%i.service
PartOf=plotsrv-demo@%i.service
StartLimitIntervalSec=10min
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
User=plotsrv-demo
Group=plotsrv-demo
EnvironmentFile=/etc/plotsrv-demo/%i.env
Environment=MPLCONFIGDIR=/var/lib/plotsrv-demo/%i/.cache/matplotlib
WorkingDirectory=/var/lib/plotsrv-demo/%i
ExecStart=/opt/plotsrv-examples/.venv/bin/python -B /opt/plotsrv-examples/demos/restore.py %i
TimeoutStartSec=3min
Restart=on-failure
RestartSec=30s
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/plotsrv-demo/%i
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
UMask=0077
MemoryMax=320M
