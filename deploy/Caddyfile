# Cloudflare-proxied website and demo origins. Caddy manages public certificates.
# Set CF_API_TOKEN in the proxy service environment, scoped to the plotsrv.com zone.
# The firewall must admit HTTPS only from Cloudflare's current origin-pull ranges.
# SSE lifetime/admission is enforced by plotsrv browser-update-settings, not stream_timeout.
{
	servers {
		timeouts {
			read_header 10s
			read_body 10s
			idle 60s
		}
		max_header_size 16KB
		strict_sni_host on
	}
}

(managed_tls) {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}
}

(demo_headers) {
	header X-Content-Type-Options nosniff
	header Referrer-Policy no-referrer
	header Permissions-Policy "camera=(), microphone=(), geolocation=()"
}

plotsrv.com {
	import managed_tls
	import demo_headers
	header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	@site {
		method GET HEAD
		path / /index.html /styles.css /shared.css /app.js /navigation.js /demos /demos/ /demos/index.html /demos/styles.css /assets/*
	}
	handle @site {
		root * /opt/plotsrv-homepage
		file_server
	}
	handle {
		respond 404
	}
}

demo.plotsrv.com {
	import managed_tls
	import demo_headers
	header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'; script-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"

	@retail path /retail /retail/
	redir @retail https://retail-demo.plotsrv.com/ 302
	@live path /live /live/
	redir @live https://live-demo.plotsrv.com/ 302
	@scans path /scans /scans/
	redir @scans https://scans-demo.plotsrv.com/ 302

	@site {
		method GET HEAD
		path / /demos/ /demos/index.html /demos/styles.css /shared.css /navigation.js /assets/favicon.png /assets/logo.png /assets/demos/*
	}
	handle @site {
		root * /opt/plotsrv-homepage
		rewrite / /demos/index.html
		file_server
	}
	handle {
		respond 404
	}
}

retail-demo.plotsrv.com {
	import managed_tls
	import demo_headers
	# Cold-cache conference arrivals must not consume the dynamic-read budget.
	@static {
		method GET HEAD
		path /static/* /assets/*
	}
	handle @static {
		route {
			rate_limit {
				sweep_interval 15s
				zone retail_static_client {
					key {http.request.header.Cf-Connecting-Ip}
					events 2400
					window 10s
				}
				zone retail_static_total {
					key retail_static
					events 4800
					window 10s
				}
			}
			reverse_proxy 127.0.0.1:8101 {
				unhealthy_request_count 128
				header_up -Authorization
				header_up -Cookie
				header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
				header_up X-Forwarded-Proto https
			}
		}
	}
	@read {
		method GET HEAD
		path / /plot /artifact /table/data /table/export /status /checks /updates /history/navigation /history/month /history /compare/latest
	}
	handle @read {
		route {
			# The key is trustworthy only while direct origin access is blocked.
			rate_limit {
				sweep_interval 15s
				zone retail_client {
					key {http.request.header.Cf-Connecting-Ip}
					events 900
					window 10s
				}
				zone retail_total {
					key retail
					events 1200
					window 10s
				}
			}
			reverse_proxy 127.0.0.1:8101 {
				unhealthy_request_count 128
				header_up -Authorization
				header_up -Cookie
				header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
				header_up X-Forwarded-Proto https
			}
		}
	}
	handle {
		respond 404
	}
}

