# Reference origin configuration for Cloudflare-proxied demo.plotsrv.com.
# The origin certificate must cover demo.plotsrv.com and the three *-demo.plotsrv.com hosts.
# The firewall must admit HTTPS only from Cloudflare's current origin-pull ranges.
# SSE lifetime/admission is enforced by plotsrv browser-update-settings, not stream_timeout.
{
	servers {
		timeouts {
			read_header 10s
			read_body 10s
			idle 60s
		}
		max_header_size 16KB
		strict_sni_host on
	}
}

(demo_headers) {
	header X-Content-Type-Options nosniff
	header Referrer-Policy no-referrer
	header Permissions-Policy "camera=(), microphone=(), geolocation=()"
}

demo.plotsrv.com {
	tls /etc/plotsrv-demo/origin.crt /etc/plotsrv-demo/origin.key
	import demo_headers
	header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"

	@retail path /retail /retail/
	redir @retail https://retail-demo.plotsrv.com/ 302
	@live path /live /live/
	redir @live https://live-demo.plotsrv.com/ 302
	@scans path /scans /scans/
	redir @scans https://scans-demo.plotsrv.com/ 302

	@site {
		method GET HEAD
		path / /styles.css /assets/*
	}
	handle @site {
		root * /opt/plotsrv-examples/site
		file_server
	}
	handle {
		respond 404
	}
}

retail-demo.plotsrv.com {
	tls /etc/plotsrv-demo/origin.crt /etc/plotsrv-demo/origin.key
	import demo_headers
	# Cold-cache conference arrivals must not consume the dynamic-read budget.
	@static {
		method GET HEAD
		path /static/* /assets/*
	}
	handle @static {
		route {
			rate_limit {
				sweep_interval 15s
				zone retail_static_client {
					key {http.request.header.Cf-Connecting-Ip}
					events 2400
					window 10s
				}
				zone retail_static_total {
					key retail_static
					events 4800
					window 10s
				}
			}
			reverse_proxy 127.0.0.1:8101 {
				unhealthy_request_count 128
				header_up -Authorization
				header_up -Cookie
				header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
				header_up X-Forwarded-Proto https
			}
		}
	}
	@read {
		method GET HEAD
		path / /plot /artifact /table/data /table/export /status /updates
	}
	handle @read {
		route {
			# The key is trustworthy only while direct origin access is blocked.
			rate_limit {
				sweep_interval 15s
				zone retail_client {
					key {http.request.header.Cf-Connecting-Ip}
					events 900
					window 10s
				}
				zone retail_total {
					key retail
					events 1200
					window 10s
				}
			}
			reverse_proxy 127.0.0.1:8101 {
				unhealthy_request_count 128
				header_up -Authorization
				header_up -Cookie
				header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
				header_up X-Forwarded-Proto https
			}
		}
	}
	handle {
		respond 404
	}
}

