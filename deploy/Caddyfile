	tls /etc/plotsrv-demo/origin.crt /etc/plotsrv-demo/origin.key
	import demo_headers
	@read {
		method GET HEAD
		path / /artifact /table/data /table/export /status /updates /history/navigation /history/month /history /compare/latest /static/* /assets/*
	}
	handle @read {
		route {
			rate_limit {
				sweep_interval 15s
				zone scans_client {
					key {http.request.header.Cf-Connecting-Ip}
					events 300
					window 10s
				}
				zone scans_total {
					key scans
					events 1200
					window 10s
				}
			}
			reverse_proxy 127.0.0.1:8103 {
				unhealthy_request_count 128
				flush_interval -1
				header_up -Authorization
				header_up -Cookie
				header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
				header_up X-Forwarded-Proto https
			}
		}
	}
	handle {
		respond 404
	}
}
